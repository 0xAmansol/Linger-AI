# Copy to .env.local and fill in what you have. Every value below is optional:
# Linger falls back to mock providers wherever a key is missing, so the app
# runs and is fully testable before any real credentials exist.

# --- Database (PostgreSQL) ---
# Local dev: docker run --name linger-db -e POSTGRES_PASSWORD=linger -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:linger@localhost:5432/linger"

# --- Auth (Clerk) ---
# https://dashboard.clerk.com — leave unset to run without auth in local dev.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- AI provider (explain / simplify / define / analyze / embeddings) ---
# https://platform.openai.com/api-keys — leave unset to use the mock AIProvider.
OPENAI_API_KEY=""

# --- OCR provider (camera capture) ---
# https://console.cloud.google.com/apis/credentials — a service account JSON,
# base64-encoded on one line. Leave unset to use the mock OCRProvider.
GOOGLE_CLOUD_VISION_CREDENTIALS_BASE64=""

# --- Object storage (captured page photos) ---
# Any S3-compatible endpoint (S3, Cloudflare R2, Supabase Storage). Leave
# unset to store capture images as local data URLs in development.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
